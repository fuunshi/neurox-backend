{{#> base
  title="Reset Your Password"
  preview="Action required: Your password reset link expires in 1 hour."
  supportEmail="support@neurox.local"
  companyName="neurox"
}}

<!-- ── Category badge -->
<mj-table padding="0 0 20px" align="center">
  <tr>
    <td style="text-align: center">
      <span
        style="
          display: inline-block;
          font-family:
            &quot;Geist&quot;,
            &quot;SF Pro Display&quot;,
            -apple-system,
            BlinkMacSystemFont,
            &quot;Segoe UI&quot;,
            Helvetica,
            Arial,
            sans-serif;
          font-size: 10px;
          font-weight: 700;
          letter-spacing: 1.2px;
          text-transform: uppercase;
          color: #2563eb;
          background-color: #eff6ff;
          border: 1px solid #bfdbfe;
          border-radius: 20px;
          padding: 4px 14px;
        "
        class="t-label"
        >Account Security</span
      >
    </td>
  </tr>
</mj-table>

<!-- ── Lock icon  -->
<mj-table padding="0 0 20px" align="center">
  <tr>
    <td style="text-align: center">
      <div
        style="
          display: inline-block;
          width: 52px;
          height: 52px;
          background-color: #eff6ff;
          border-radius: 14px;
          border: 1px solid #bfdbfe;
          line-height: 52px;
          font-size: 26px;
          text-align: center;
        "
      >
        🔒
      </div>
    </td>
  </tr>
</mj-table>

<!-- ── Heading  -->
<mj-text
  align="center"
  font-size="26px"
  font-weight="700"
  line-height="1.25"
  letter-spacing="-0.5px"
  color="#0f172a"
  padding="0 0 10px"
  css-class="t-heading"
  >Reset your password</mj-text
>

<!-- ── Subheading  -->
<mj-text
  align="center"
  font-size="15px"
  color="#64748b"
  line-height="1.7"
  padding="0 0 28px"
  css-class="t-body"
>
  We received a request to reset the password for your account. If this was you,
  click the button below to set a new password.
</mj-text>

<!-- ── CTA Button  -->
<mj-button
  href="{{resetLink}}"
  background-color="#2563eb"
  color="#ffffff"
  border-radius="8px"
  css-class="neurox-btn"
>
  Reset Password
</mj-button>

<!-- ── Divider ── -->
<mj-divider
  border-color="#f1f5f9"
  border-width="1px"
  padding="4px 0 20px"
  css-class="hr-line"
/>

<!-- ── Expiry warning box  -->
<mj-text padding="0 0 16px">
  <div
    style="
      background-color: #fffbeb;
      border-left: 3px solid #f59e0b;
      border-radius: 8px;
      padding: 14px 16px;
    "
    class="box-warning"
  >
    <span
      style="
        font-family:
          &quot;Geist&quot;,
          &quot;SF Pro Display&quot;,
          -apple-system,
          BlinkMacSystemFont,
          &quot;Segoe UI&quot;,
          Helvetica,
          Arial,
          sans-serif;
        font-size: 13px;
        color: #92400e;
        line-height: 1.6;
      "
      class="box-warning"
    >
      <strong style="font-weight: 600">⏱ Link expires in 1 hour.</strong>
      After that, you'll need to request a new reset link from the login page.
    </span>
  </div>
</mj-text>

<!-- ── Separator  -->
<mj-divider
  border-color="#f1f5f9"
  border-width="1px"
  padding="8px 0 16px"
  css-class="hr-line"
/>

<!-- ── Safety note  -->
<mj-text
  font-size="12px"
  color="#94a3b8"
  line-height="1.7"
  padding="0"
  css-class="t-muted"
>
  <strong style="font-weight: 600; color: #64748b">Didn't request this?</strong>
  Your account is safe — no changes have been made. Simply ignore this email. If
  you're concerned about unauthorized access to your account, please contact our
  security team immediately at
  <a
    href="mailto:support@neurox.local"
    style="color: #2563eb; text-decoration: none"
    >support@neurox.local</a
  >.
</mj-text>

{{/base}}