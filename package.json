{
  "name": "neurox-backend",
  "version": "0.0.1",
  "description": "neurox backend API — NestJS on Fastify, PostgreSQL via MikroORM, Redis/BullMQ queues and SMTP email",
  "author": "fuunshi",
  "private": true,
  "license": "MIT",
  "scripts": {
    "clean": "node -e \"const fs=require('fs'); for (const p of ['dist','tsconfig.build.tsbuildinfo','tsconfig.tsbuildinfo']) fs.rmSync(p,{recursive:true,force:true})\"",
    "prebuild": "pnpm run clean",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "prestart:dev": "pnpm run clean",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "prestart:debug": "pnpm run clean",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "prestart:worker:dev": "pnpm run clean",
    "start:worker": "nest start --entryFile worker.main",
    "start:worker:dev": "nest start --watch --entryFile worker.main",
    "prestart:worker:debug": "pnpm run clean",
    "start:worker:debug": "nest start --debug 9230 --watch --entryFile worker.main",
    "start:worker:prod": "node dist/worker.main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "migrate:make": "mikro-orm migration:create",
    "migrate:up": "mikro-orm migration:up",
    "migrate:down": "mikro-orm migration:down",
    "migrate:deploy": "mikro-orm migration:up",
    "migrate:list": "mikro-orm migration:list",
    "migrate:pending": "mikro-orm migration:pending",
    "schema:dump": "mikro-orm schema:create --dump",
    "schema:update": "mikro-orm schema:update --run",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --no-file-parallelism",
    "test:e2e": "vitest run --config vitest.e2e.config.mts",
    "prepare": "node -e \"if (!process.env.CI) process.exit(0)\" && husky",
    "seed": "nest start --entryFile seeder/seed",
    "curriculum:seed": "nest start --entryFile seeder/curriculum"
  },
  "dependencies": {
    "@fastify/compress": "^9.2.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^10.1.1",
    "@fastify/static": "^10.1.4",
    "@mikro-orm/cli": "^7.2.1",
    "@mikro-orm/core": "^7.2.1",
    "@mikro-orm/migrations": "^7.2.1",
    "@mikro-orm/nestjs": "^7.1.0",
    "@mikro-orm/postgresql": "^7.2.1",
    "@nestjs-modules/ioredis": "^2.2.1",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.0.4",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.4",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/microservices": "^12.0.4",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.0.4",
    "@nestjs/platform-fastify": "^12.0.4",
    "@nestjs/platform-socket.io": "^12.1.0",
    "@nestjs/swagger": "^12.0.1",
    "@nestjs/terminus": "^12.1.0",
    "@nestjs/throttler": "^6.7.0",
    "@nestjs/websockets": "^12.1.0",
    "@prometheus-io/client": "^0.16.1",
    "amqp-connection-manager": "^5.0.0",
    "amqplib": "^0.10.9",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.71.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^18.0.2",
    "fastify": "^5.12.5",
    "handlebars": "^4.7.9",
    "ioredis": "^5.11.1",
    "mammoth": "^1.12.3",
    "mjml": "^5.1.0",
    "ms": "^2.1.3",
    "nodemailer": "^7.0.13",
    "pdf-parse": "^2.4.5",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.3",
    "speakeasy": "^2.0.0",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.3",
    "@nestjs/schematics": "^12.0.4",
    "@nestjs/testing": "^12.0.4",
    "@swc/cli": "^0.8.0",
    "@swc/core": "^1.15.18",
    "@types/amqplib": "^0.10.8",
    "@types/ms": "^2.1.0",
    "@types/node": "^25.5.0",
    "@types/qrcode": "^1.5.6",
    "@types/speakeasy": "^2.0.10",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "prettier": "^3.8.1",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.57.1",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.1"
  },
  "mikro-orm": {
    "configPaths": [
      "./src/mikro-orm.config.ts",
      "./dist/mikro-orm.config.js"
    ],
    "useTsNode": true
  }
}
