<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all
        font-family="'Geist', 'SF Pro Display', -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif"
      />
      <mj-text
        color="#0f172a"
        font-size="15px"
        line-height="1.75"
        padding="0 0 16px"
      />
      <mj-button
        font-family="'Geist', 'SF Pro Display', -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif"
        font-size="14px"
        font-weight="600"
        letter-spacing="0.3px"
        inner-padding="14px 32px"
        border-radius="8px"
        align="center"
        padding="4px 0 24px"
      />
      <mj-divider border-color="#e2e8f0" border-width="1px" padding="20px 0" />
      <mj-image padding="0" />
    </mj-attributes>

    <mj-preview
      >{{#if preview}}{{ preview }}{{else}}{{ title }} — neurox{{/if}}</mj-preview
    >

    <!--
      Dark mode: targeting the compiled td/table classes that MJML generates.
      Using !important to override inline styles where needed.
    -->
    <mj-style>
      @media (prefers-color-scheme: dark) {
        /* Page shell */
        body,
        .neurox-shell {
          background-color: #020617 !important;
        }

        /* Header */
        .neurox-header td {
          background-color: #020617 !important;
        }

        /* Card */
        .neurox-card {
          background-color: #0f172a !important;
          border-color: #1e293b !important;
        }

        /* Footer */
        .neurox-footer td {
          background-color: #020617 !important;
        }

        /* Typography */
        .t-heading {
          color: #f8fafc !important;
        }

        .t-body {
          color: #94a3b8 !important;
        }

        .t-muted {
          color: #475569 !important;
        }

        .t-label {
          color: #3b82f6 !important;
        }

        .t-footer {
          color: #334155 !important;
        }

        /* Divider */
        .hr-line p {
          border-color: #1e293b !important;
        }

        /* Warning box */
        .box-warning {
          background-color: #1c1400 !important;
          border-left-color: #f59e0b !important;
        }

        .box-warning span {
          color: #fbbf24 !important;
        }

        /* Button */
        .neurox-btn a {
          background-color: #2563eb !important;
        }

        /* Security badge */
        .badge-security {
          background-color: #0f172a !important;
          border-color: #1e293b !important;
        }

        .badge-security span {
          color: #3b82f6 !important;
        }
      }
    </mj-style>

    <mj-style inline="inline">
      .neurox-shell {
        background-color: #f1f5f9;
      }

      .neurox-card {
        border: 1px solid #e2e8f0;
      }
    </mj-style>
  </mj-head>

  <mj-body css-class="neurox-shell" background-color="#f1f5f9" width="620px">
    <!-- ── Brand accent bar  -->
    <mj-section padding="0" background-color="#0f172a">
      <mj-column padding="0">
        <mj-table padding="0">
          <tr>
            <td
              style="
                height: 3px;
                background: linear-gradient(
                  90deg,
                  #2563eb 0%,
                  #06b6d4 50%,
                  #8b5cf6 100%
                );
              "
            ></td>
          </tr>
        </mj-table>
      </mj-column>
    </mj-section>

    <!-- ── Header  -->
    {{> header logoUrl=logoUrl logoAlt=logoAlt}}

    <!-- ── Content card  -->
    <mj-section padding="0 24px 20px" css-class="neurox-shell">
      <mj-column
        background-color="#ffffff"
        border-radius="16px"
        padding="40px 36px"
        css-class="neurox-card"
      >
        {{> @partial-block}}
      </mj-column>
    </mj-section>

    <!-- ── Footer  -->

    {{> footer
      supportEmail=supportEmail
      companyName=companyName
      companyLocation=companyLocation
    }}

    <!-- ── Bottom spacer -->
    <mj-section padding="0 24px 32px" css-class="neurox-shell">
      <mj-column>
        <mj-text
          align="center"
          font-size="11px"
          color="#94a3b8"
          line-height="1.6"
          padding="0"
          css-class="t-muted"
        >
          You received this because your account is registered with
          {{#if companyName}}{{ companyName }}{{else}}neurox{{/if}}.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>