{
  "extends": "./tsconfig.json",
  // `exclude` REPLACES the base config's list rather than merging, so this
  // repeats the base exclusions instead of relying on inheritance.
  "exclude": [
    "node_modules",
    "test",
    "dist",
    "**/*spec.ts",
    "vitest.config.mts",
    "vitest.e2e.config.mts"
  ]
}
