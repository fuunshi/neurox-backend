# App Configuration
PORT=3000
NODE_ENV=development
# Base URL of the web app. The verification and password-reset emails build their
# links from this value (`${FRONTEND_URL}/auth/verify-email?token=…` and
# `${FRONTEND_URL}/reset-password?token=…`), so a wrong port produces emails that
# link nowhere -- and it fails silently, unlike a missing value, which throws at
# the point of use. The web app's dev server runs on 3001.
FRONTEND_URL=http://localhost:3001
# Browser origins allowed to call the API, comma-separated. The frontend's own
# dev server calls the API through its route handlers (same-origin), so this only
# matters for a client that talks to the API from a page.
CORS_ORIGINS=http://localhost:3001
SUPPORT_EMAIL=support@neurox.ai


# Auth Configuration
JWT_SECRET=your-jwt-secret
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_EXPIRES_IN=7d
EMAIL_VERIFICATION_TOKEN_EXPIRES_IN=15m
# HMAC key used to hash refresh/reset tokens at rest. REQUIRED: the app refuses
# to start without it. Rotating this invalidates every stored token hash, so
# refresh tokens and outstanding reset links stop resolving.
TOKEN_HASH_SECRET=your-token-hash-secret

# Account Lifecycle
# Cron schedule for releasing the email addresses of deleted accounts.
# The grace period itself is an admin-editable row in the `app_setting`
# table (key: account.recycleGraceDays, default 7) -- not an env var.
ACCOUNT_RECYCLE_CRON=0 3 * * *

# Maintenance
# Cron schedule for pruning expired tokens and old request_log rows. The
# retention windows themselves are admin-editable rows in the `app_setting`
# table (`observability.requestLogRetentionDays`, default 30 days) -- not env
# vars. Nothing bounded request_log before this job existed.
MAINTENANCE_CRON=17 4 * * *

# MFA / TOTP Configuration
MFA_TEMP_TOKEN_EXPIRES_IN=5m
MFA_ISSUER=neurox

# Realtime
# Lifetime of the one-shot ticket that opens a WebSocket. Short by design: a
# socket handshake cannot carry the session's httpOnly cookie to another origin,
# so this is the only credential the browser is ever handed, and a minute is
# long enough to use and short enough that stealing it is pointless. The token
# is typed `realtime`, which no REST route accepts.
REALTIME_TICKET_EXPIRES_IN=1m

# Database Configuration (PostgreSQL)
# MikroORM reads this via the `database.url` namespace. A trailing
# `?schema=public` (Prisma-era format) is stripped before use.
DATABASE_URL="postgresql://postgresuser:password@localhost:5432/neurox"

# Redis Configuration for BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Only needed if you enable the optional RedisModule (currently commented out
# of InfraModule); BullMQ itself uses the host/port/password above.
REDIS_URL=redis://localhost:6379

# Throttler Configuration (optional - defaults shown)
# THROTTLE_SHORT_TTL=1000
# THROTTLE_SHORT_LIMIT=3
# THROTTLE_MEDIUM_TTL=10000
# THROTTLE_MEDIUM_LIMIT=20
# THROTTLE_LONG_TTL=60000
# THROTTLE_LONG_LIMIT=100

# RabbitMQ Configuration
RABBITMQ_URL=amqp://localhost:5672
# RABBITMQ_URLS=amqp://localhost:5672,amqp://localhost:5673
RABBITMQ_MAIL_QUEUE=mail.outbound
RABBITMQ_QUEUE_DURABLE=true

# SMTP Configuration
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@neurox.local
APP_BASE_URL=http://localhost:3000

# Card Generation (Gemini)
# Optional. Without a key, generation falls back to the deterministic rule-based
# generator, which extracts cards from "X is Y" and "X: Y" patterns and markdown
# headings. That path needs no network and no account, so the whole pipeline --
# job, queue, draft cards, review -- works out of the box.
#
# With a key, the model reads definitions spread across several sentences and
# paraphrases them, which is what the heuristic one cannot do. Set it and the
# switch is automatic; no code change and no redeploy of the generator choice.
GEMINI_API_KEY=
# Flash is the default: card extraction is bounded and well-specified.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=60000

# neurox-brain -- the local NLP service
#
# A separate Python service (see ../neurox-brain) that turns text into cards,
# quiz questions, keywords and summaries using spaCy, TF-IDF and TextRank. No
# LLM, no third-party API, no per-card cost.
#
# It sits between the other two generators, and the preference order lives in
# `GenerationService.defaultGenerator`: brain, then Gemini, then the heuristic.
# Enabling it is an explicit decision rather than inferred from the URL having a
# working default -- otherwise every developer's machine would depend on a
# Python service being up.
#
# Start it with:  cd ../neurox-brain && ./scripts/dev.sh
NEUROX_BRAIN_ENABLED=false
NEUROX_BRAIN_URL=http://localhost:8000

# http -- the API calls the service and waits. Correct for the chunk sizes the
#         generator sends (a 2,000-character chunk analyses in ~1.5s), and needs
#         no extra infrastructure.
# amqp -- jobs go over RabbitMQ and results come back on a reply queue, which
#         both sides already know how to do. Worth it when a document is large
#         enough that holding a request open is the wrong shape.
NEUROX_BRAIN_TRANSPORT=http

NEUROX_BRAIN_TIMEOUT_MS=30000
NEUROX_BRAIN_AMQP_URL=amqp://neurox:neurox@localhost:5672
NEUROX_BRAIN_JOB_QUEUE=brain.jobs
NEUROX_BRAIN_RESULT_QUEUE=brain.results

# Shared secret for the webhook signature. Required only when the brain posts
# results back to us rather than answering a request we made. Without it, any
# host that can reach the callback endpoint could inject a result -- and a
# result is what writes cards into somebody's deck.
NEUROX_BRAIN_WEBHOOK_SECRET=

# Observability
# GET /metrics and the two health endpoints. Both are outside the application's
# own API surface: they opt out of the REST envelope, the request log, the
# throttler and auth, because Prometheus and container runtimes read neither
# JSON envelopes nor bearer tokens.
#
# Set this to false to take /metrics off the wire entirely. On by default --
# a deployment that has to remember to switch metrics on is one that finds the
# gap while looking at an incident rather than before it.
METRICS_ENABLED=true

# How long any single dependency probe may take before it counts as down.
# Short on purpose: a health endpoint that waits on a hung dependency is a
# health endpoint that hangs.
HEALTH_PROBE_TIMEOUT_MS=2000
