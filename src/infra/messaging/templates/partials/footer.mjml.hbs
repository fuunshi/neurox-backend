<!-- partials/footer.mjml -->

<mj-section
  padding="0 24px 0"
  background-color="#f1f5f9"
  css-class="neurox-footer neurox-shell"
>
  <mj-column padding="0 0 20px">
<!-- Support link -->
    {{#if supportEmail}}
    <mj-text
      align="center"
      font-size="12px"
      color="#64748b"
      line-height="1.6"
      padding="0 0 8px"
      css-class="t-muted"
    >
      Need help? Reach us at
      <a
        href="mailto:{{supportEmail}}"
        style="color: #2563eb; text-decoration: none; font-weight: 500;"
      >{{supportEmail}}</a>
    </mj-text>
    {{/if}}

    <!-- Copyright + company info -->
    <mj-text
      align="center"
      font-size="11px"
      color="#94a3b8"
      line-height="1.8"
      padding="0"
      css-class="t-footer"
    >
      &copy; {{date}} {{#if companyName}}{{companyName}}{{else}}neurox{{/if}}. All rights reserved.
      {{#if companyLocation}}
        <br/>{{companyLocation}}
      {{/if}}
    </mj-text>
  </mj-column>
</mj-section>