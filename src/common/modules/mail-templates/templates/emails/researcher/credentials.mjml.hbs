<!--emails / welcome - researcher.mjml-->

{{#> base
  title="Your neurox Researcher Account"
  preview="Your researcher account has been created. Login details inside."
  supportEmail="support@neurox.local"
  companyName="neurox"
}}

<!-- ── Category badge -->
<mj-table padding="0 0 20px" align="center">
  <tr>
    <td style="text-align: center">
      <span
        style="
          display: inline-block;
          font-family:
            &quot;Geist&quot;,
            &quot;SF Pro Display&quot;,
            -apple-system,
            BlinkMacSystemFont,
            &quot;Segoe UI&quot;,
            Helvetica,
            Arial,
            sans-serif;
          font-size: 10px;
          font-weight: 700;
          letter-spacing: 1.2px;
          text-transform: uppercase;
          color: #2563eb;
          background-color: #eff6ff;
          border: 1px solid #bfdbfe;
          border-radius: 20px;
          padding: 4px 14px;
        "
        class="t-label"
        >Account Created</span
      >
    </td>
  </tr>
</mj-table>

<!-- ── Heading -->
<mj-text
  align="center"
  font-size="26px"
  font-weight="700"
  line-height="1.25"
  letter-spacing="-0.5px"
  color="#0f172a"
  padding="0 0 10px"
  css-class="t-heading"
  >Your researcher account is ready</mj-text
>

<!-- ── Subheading -->
<mj-text
  align="center"
  font-size="15px"
  color="#64748b"
  line-height="1.7"
  padding="0 0 28px"
  css-class="t-body"
>
  Welcome to neurox! Your researcher account has been successfully created. You
  can now access the platform using the details below.
</mj-text>

<!-- ── Account Details Box -->
<mj-text padding="0 0 20px">
  <div style="
      background-color: #f8fafc;
      border-radius: 8px;
      padding: 14px 16px;
    " class="badge-security">
    <span style="
        font-family:
          &quot;Geist&quot;,
          &quot;SF Pro Display&quot;,
          -apple-system,
          BlinkMacSystemFont,
          &quot;Segoe UI&quot;,
          Helvetica,
          Arial,
          sans-serif;
        font-size: 13px;
        line-height: 1.6;
      ">
      <strong>Email:</strong> {{ email }}<br />
      <strong>Temporary Password:</strong> {{ password }}
    </span>
  </div>
</mj-text>

<!-- ── CTA Button -->
<mj-button
  href="{{loginLink}}"
  background-color="#1f6feb"
  color="#ffffff"
  border-radius="8px"
  inner-padding="12px 24px"
  css-class="neurox-btn"
  padding="20px 0 12px"
>
  Login to neurox
</mj-button>

<!-- ── Important note -->
<mj-text
  align="center"
  font-size="14px"
  color="#64748b"
  line-height="1.6"
  padding="0 0 24px"
>
  Please sign in and <strong>change your password immediately</strong> for
  security.
</mj-text>

<!-- ── Divider -->
<mj-divider
  border-color="#f1f5f9"
  border-width="1px"
  padding="4px 0 20px"
  css-class="hr-line"
/>

<!-- ── Security note -->
<mj-text
  font-size="12px"
  color="#94a3b8"
  line-height="1.7"
  padding="0"
  css-class="t-muted"
>
  <strong style="font-weight: 600; color: #64748b">Security Reminder</strong
  ><br />
  If you did not request this account, please contact our support team
  immediately at
  <a
    href="mailto:support@neurox.local"
    style="color: #2563eb; text-decoration: none"
    >support@neurox.local</a
  >.
</mj-text>

{{/base}}