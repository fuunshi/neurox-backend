{{#> base
  title="Your neurox Organization Account"
  preview="Your organization account has been created. Login details inside."
  supportEmail="support@neurox.local"
  companyName="neurox"
}}

<mj-table padding="0 0 20px" align="center">
  <tr>
    <td style="text-align: center">
      <span
        style="
          display: inline-block;
          font-family: Arial, sans-serif;
          font-size: 10px;
          font-weight: 700;
          letter-spacing: 1.2px;
          text-transform: uppercase;
          color: #2563eb;
          background-color: #eff6ff;
          border: 1px solid #bfdbfe;
          border-radius: 20px;
          padding: 4px 14px;
        "
      >Account Created</span>
    </td>
  </tr>
</mj-table>

<mj-text
  align="center"
  font-size="26px"
  font-weight="700"
  line-height="1.25"
  color="#0f172a"
  padding="0 0 10px"
>
  Your organization account is ready
</mj-text>

<mj-text
  align="center"
  font-size="15px"
  color="#64748b"
  line-height="1.7"
  padding="0 0 28px"
>
  Welcome to neurox! An organization owner has added you as a member. You can now access the platform using the details below.
</mj-text>

<mj-text padding="0 0 20px">
  <div style="background-color: #f8fafc; border-radius: 8px; padding: 14px 16px;">
    <span style="font-family: Arial, sans-serif; font-size: 13px; line-height: 1.6;">
      <strong>Email:</strong> {{ email }}<br />
      <strong>Temporary Password:</strong> {{ password }}
    </span>
  </div>
</mj-text>

<mj-button
  href="{{userLoginUrl}}"
  background-color="#1f6feb"
  color="#ffffff"
  border-radius="8px"
  inner-padding="12px 24px"
  padding="20px 0 12px"
>
  Login to neurox
</mj-button>

<mj-text
  align="center"
  font-size="14px"
  color="#64748b"
  line-height="1.6"
  padding="0 0 24px"
>
  Please sign in and <strong>change your password immediately</strong> for security.
</mj-text>

{{/base}}