# App Configuration
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
SUPPORT_EMAIL=support@neurox.ai


# Auth Configuration
JWT_SECRET=your-jwt-secret
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_EXPIRES_IN=7d
EMAIL_VERIFICATION_TOKEN_EXPIRES_IN=15m

# MFA / TOTP Configuration
MFA_TEMP_TOKEN_EXPIRES_IN=5m
MFA_ISSUER=neurox

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/mydatabase"

# Redis Configuration for BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Throttler Configuration (optional - defaults shown)
# THROTTLE_SHORT_TTL=1000
# THROTTLE_SHORT_LIMIT=3
# THROTTLE_MEDIUM_TTL=10000
# THROTTLE_MEDIUM_LIMIT=20
# THROTTLE_LONG_TTL=60000
# THROTTLE_LONG_LIMIT=100

# RabbitMQ Configuration
RABBITMQ_URL=amqp://localhost:5672
# RABBITMQ_URLS=amqp://localhost:5672,amqp://localhost:5673
RABBITMQ_MAIL_QUEUE=mail.outbound
RABBITMQ_QUEUE_DURABLE=true

# SMTP Configuration
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@neurox.local
APP_BASE_URL=http://localhost:3000