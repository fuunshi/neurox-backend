<!-- partials/header.mjml -->

<!-- Dark nav-bar style header -->
<mj-section
  padding="0"
  background-color="#0f172a"
  css-class="neurox-header"
>
  <mj-column padding="24px 32px">

    {{#if logoUrl}}
      <!-- Logo image -->
      <mj-image
        width="120px"
        src="{{logoUrl}}"
        alt="{{#if logoAlt}}{{logoAlt}}{{else}}neurox{{/if}}"
        align="center"
        padding="0"
      />
    {{else}}
      <!-- Wordmark fallback when no logo is provided -->
      <mj-table align="center" padding="0">
        <tr>
          <td style="text-align: center; vertical-align: middle;">
            <span style="display: inline-block; vertical-align: middle; font-family: 'Geist', 'SF Pro Display', -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif; font-size: 18px; font-weight: 700; letter-spacing: -0.4px; color: #f8fafc;">
              PT<span style="color: #2563eb;">AS</span>
            </span>
          </td>
        </tr>
      </mj-table>
    {{/if}}

  </mj-column>
</mj-section>

<!-- Gradient separator between header and body -->
<mj-section padding="0" background-color="#0f172a" css-class="neurox-header">
  <mj-column padding="0">
    <mj-table padding="0">
      <tr>
        <td style="height:1px; background: linear-gradient(90deg, transparent 0%, #1e293b 20%, #1e293b 80%, transparent 100%);"></td>
      </tr>
    </mj-table>
  </mj-column>
</mj-section>

<!-- Header-to-card breathing room -->
<mj-section padding="24px 0 0" css-class="neurox-shell">
  <mj-column padding="0">
  </mj-column>
</mj-section>